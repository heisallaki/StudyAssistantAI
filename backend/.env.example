DATABASE_URL=postgresql+psycopg2://studyassistant:changeme_dev_password@localhost:5432/studyassistant_dev
# TEST_DATABASE_URL=postgresql+psycopg2://studyassistant:changeme_dev_password@localhost:5432/studyassistant_dev_test
JWT_SECRET_KEY=replace-with-output-of-openssl-rand-hex-32
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=all-minilm
# AI_PROVIDER=ollama is for local development only. Outside ENVIRONMENT=development,
# AI_PROVIDER and AI_FALLBACK_PROVIDER must be "gemini" or "groq" or the app will refuse to start.
AI_PROVIDER=ollama
# AI_PROVIDER=gemini
# AI_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_PROVIDER=ollama
# EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./.fastembed_cache
STORAGE_BACKEND=local
# STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
PROJECT_NAME=StudyAssistant AI
API_V1_PREFIX=/api/v1
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
FAILED_LOGIN_LOCKOUT_THRESHOLD=5
FAILED_LOGIN_LOCKOUT_MINUTES=15
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
EMAIL_VERIFICATION_REQUIRED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kal.projects.dev@gmail.com
SMTP_PASSWORD=replace-with-a-gmail-app-password
SMTP_FROM_EMAIL=kal.projects.dev@gmail.com
SMTP_FROM_NAME=StudyAssistant AI
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT=5/hour